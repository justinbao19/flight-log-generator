# OpenClaw/OpenAI-compatible API settings for flight data recognition
OPENCLAW_API_KEY=sk-...
OPENCLAW_BASE_URL=https://llm-proxy.tapsvc.com/v1
OPENCLAW_MODEL=gpt-5.4

# Optional token required by agent write endpoints when set.
# Send it as the x-agent-token header.
FLIGHT_LOG_AGENT_TOKEN=change-me
